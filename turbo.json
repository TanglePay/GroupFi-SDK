{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build:staging": {
            "outputs": ["dist/**"],
            "dependsOn": ["^build:staging"]
        },
        "build:prerelease": {
            "outputs": ["dist/**"],
            "dependsOn": ["^build:prerelease"]
        },
        "build:production": {
            "outputs": ["dist/**"],
            "dependsOn": ["^build:production"]
        }
    }
}